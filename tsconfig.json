{
  // https://nuxt.com/docs/guide/concepts/typescript
  "compilerOptions": {
    "typeRoots": [
      "./types",
      "./node_modules/@types"
    ],
    "baseUrl": ".",
    "paths": {
      "@/*": ["./*"],
      "~/*": ["./app/*"],
      "~~/*": ["./*"],
      "#app": [".nuxt/types/app"],
      "#build": [".nuxt/types"]
    },
    
  },
  "include": [
    "types/**/*.d.ts",
    "types/*.d.ts",
    "app/**/*",
    "shared/**/*",
    "server/**/*",
    "app/**/*.vue",
    "app/**/*.ts",
    "app/**/*.js"
  ]
}
